# ── Frontend environment variables ──────────────────────────────────────────
#
# Copy this file to .env and fill in your values.
#
# VITE_API_URL
#   URL where your FastAPI backend is running.
#   Local dev: http://localhost:8000
#   Deployed:  https://your-backend.railway.app  (or wherever you host it)
#
VITE_API_URL=http://localhost:8000

# VITE_NEON_AUTH_URL
#   Your Neon Auth project URL (from the Neon dashboard → Auth → Setup).
#   Leave as the placeholder if you are not using Neon Auth — the app will
#   skip the login screen and run fully in local mode.
#
VITE_NEON_AUTH_URL=https://your-neon-auth-url-here
