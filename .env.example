# ════════════════════════════════════════════════════════════════════════════
#  AutoScheduler — Environment Variables Template
#  Copy this file to .env and fill in your values.
#  NEVER commit .env to git — only commit this .env.example file.
# ════════════════════════════════════════════════════════════════════════════

# Frontend: URL where the FastAPI backend is running
# Local dev  → http://localhost:8000  (leave as-is)
# Deployed   → https://your-app.railway.app
VITE_API_URL=http://localhost:8000

# Backend: Secret key used to sign JWT tokens
# Change this to any long random string before deploying to production
# Generate one: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=autoscheduler-change-this-secret-in-production
